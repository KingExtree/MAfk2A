{
    "AutoCampaign": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CampaignInit",
                "custom_action_param": {
                    "send_help": "false"
                }
            }
        },
        "next": [
            "CampaignPhantomEntry"
        ]
    },

    "CampaignPhantomEntry": {
        "action": {
            "type": "Click",
            "param": {
                "target": [190, 1071, 1, 1]
            }
        },
        "post_delay": 3000,
        "next": ["OpenRecommended"]
    },
    "CampaignNormalEntry": {
