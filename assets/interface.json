{
    "interface_version": 2,
    "name": "MAFK2A",
    "description": "剑与远征：启程",
    "contact": "",
    "license": "MIT",
    "welcome": "欢迎使用 MAFK2A！",
    "github": "https://github.com/KingExtree/MAfk2A",
    "version": "1.0.0",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "剑与远征：启程",
                "screencap": "Background",
                "mouse": "SendMessageWithWindowPos",
                "keyboard": "PostMessageWithWindowPos"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "agent/main.py"
        ]
    },
    "task": [
        {
            "name": "自动推挂机关卡",
            "label": "自动推关",
            "description": "自动推关，依次尝试所有作业，先幻灵后普通",
            "entry": "AutoCampaign",
            "option": [
                "救救孩子"
            ]
        }
    ],
    "global_option": [
        "分辨率"
    ],
    "option": {
        "分辨率": {
            "type": "select",
            "label": "分辨率",
            "description": "选择游戏分辨率",
            "default_case": "720x1280",
            "cases": [
                {
                    "name": "720x1280",
                    "label": "720 × 1280"
                },
                {
                    "name": "550x978",
                    "label": "550 × 978",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "next": ["CampaignPhantomEntry_550"],
                            "custom_action_param": {
                                "resolution": "550x978"
                            }
                        }
                    }
                }
            ]
        },
        "救救孩子": {
            "type": "switch",
            "label": "救救孩子",
            "description": "全部失败后在工会频道发送救救孩子",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "send_help": "True"
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "send_help": "False"
                            }
                        }
                    }
                }
            ]
        }
    }
}