{
    "interface_version": 2,
    "name": "MAFK2A",
    "description": "剑与远征：启程",
    "contact": "",
    "license": "MIT",
    "welcome": "欢迎使用 MAFK2A！",
    "github": "https://github.com/KingExtree/MAfk2A",
    "version": "1.0.6",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "剑与远征：启程",
                "screencap": "PrintWindow",
                "mouse": "SendMessageWithWindowPos",
                "keyboard": "PostMessageWithWindowPos"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "agent/main.py"
        ]
    },
    "task": [
        {
            "name": "自动推挂机关卡",
            "label": "自动推关",
            "description": "自动推关，依次尝试所有作业",
            "entry": "AutoCampaign",
            "option": [
                "救救孩子",
                "挑战类型",
                "重试次数"
            ]
        }
    ],
    "global_option": [
        "分辨率"
    ],
    "option": {
        "分辨率": {
            "type": "select",
            "label": "分辨率",
            "description": "选择游戏分辨率",
            "default_case": "720x1280",
            "cases": [
                {
                    "name": "720x1280",
                    "label": "720 × 1280"
                },
                {
                    "name": "550x978",
                    "label": "550 × 978",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "resolution": "550x978"
                            }
                        }
                    }
                }
            ]
        },
        "救救孩子": {
            "type": "switch",
            "label": "救救孩子",
            "description": "全部失败后在工会频道发送救救孩子",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "send_help": "True"
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "send_help": "False"
                            }
                        }
                    }
                }
            ]
        },
        "挑战类型": {
            "type": "select",
            "label": "挑战类型",
            "description": "选择要挑战的关卡类型",
            "default_case": "both",
            "cases": [
                {
                    "name": "both",
                    "label": "幻灵 + 普通",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "challenge": "both"
                            }
                        }
                    }
                },
                {
                    "name": "phantom",
                    "label": "幻灵",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "challenge": "phantom"
                            }
                        }
                    }
                },
                {
                    "name": "normal",
                    "label": "普通",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "challenge": "normal"
                            }
                        }
                    }
                }
            ]
        },
        "重试次数": {
            "type": "select",
            "label": "重试次数",
            "description": "全部失败后从头重试的次数",
            "default_case": "0",
            "cases": [
                {
                    "name": "0",
                    "label": "不重试"
                },
                {
                    "name": "1",
                    "label": "1 次",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "retry": "1"
                            }
                        }
                    }
                },
                {
                    "name": "2",
                    "label": "2 次",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "retry": "2"
                            }
                        }
                    }
                },
                {
                    "name": "3",
                    "label": "3 次",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "retry": "3"
                            }
                        }
                    }
                },
                {
                    "name": "4",
                    "label": "4 次",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "retry": "4"
                            }
                        }
                    }
                },
                {
                    "name": "5",
                    "label": "5 次",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "retry": "5"
                            }
                        }
                    }
                },
                {
                    "name": "infinite",
                    "label": "无限次",
                    "pipeline_override": {
                        "AutoCampaign": {
                            "custom_action_param": {
                                "retry": "infinite"
                            }
                        }
                    }
                }
            ]
        }
    }
}